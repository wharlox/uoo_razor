


#### script to automatically run after this script
####   to enable: uncomment the pushlist line, add in the path to the next script after Play Script
@removelist _util__hotkey_armorer__script_chain
@createlist _util__hotkey_armorer__script_chain
#@pushlist _util__hotkey_armorer__script_chain "Play Script: AutoDexxer"



#### modes
##   [dynamic] slot un-equip, prev-item in backpack or corpse == keep prev-item memorized OR clear memory for slot
##   [static] slot equipped, prev-item in backpack or corpse == USE NEW ITEM
##   [todo] get-all-layers or just aspectable-layers




#### forget_unequipped_accessible_items - default 0
##   if a layer is empty but slotted item is in backpack or corpse
##     0 - do not forget about item
##     1 - forget about item
@setvar!  _util__hotkey_armorer__mode__forget_unequipped_accessible_items  0




#### enforce_run_twice - default 1
##   0 disables - script will run immediatly in full
##   1 enables  - script will need to be executed twice
@setvar _util__hotkey_armorer__enforce_run_twice 1









if _util__hotkey_armorer__enforce_run_twice == 1
    @removelist _util__hotkey_armorer__name
    @createlist _util__hotkey_armorer__name
    
    #### a friendly value of this script
    @pushlist   _util__hotkey_armorer__name  "query-armor-n-weaps"


    if not listexists _util__hotkey_armorer__name_previous
        @createlist _util__hotkey_armorer__name_previous
        foreach _itr in _util__hotkey_armorer__name
            @pushlist _util__hotkey_armorer__name_previous _itr
            sysmsg "click again to save armor and weapon profile" 44

            stop
        endfor
    endif


    foreach _itr in _util__hotkey_armorer__name
        foreach _itr_prev in _util__hotkey_armorer__name_previous
            @removelist _util__hotkey_armorer__name_previous
            if _itr == _itr_prev
                sysmsg  "saving armor and weapons..." 70
                overhead "saving armor and weapons..." 70
                @removelist _util__hotkey_armorer__name
            else
                sysmsg   "ERROR: this script `{{_itr}}` does not match the previous triggered script `{{_itr_prev}}` - try again" 33
                overhead "ERROR: this script `{{_itr}}` does not match the previous triggered script `{{_itr_prev}}` - try again" 33
                stop
            endif
            break
        endfor
        break
    endfor
else
    sysmsg "saving armor and weapons..." 70
    overhead "saving armor and weapons..." 70
    if listexists _util__hotkey_armorer__name
        @removelist _util__hotkey_armorer__name
    endif
    if listexists _util__hotkey_armorer__name_previous
        @removelist _util__hotkey_armorer__name_previous
    endif
endif







##### get equipped layered items
@removelist _util__armorer__layers
@createlist _util__armorer__layers
@pushlist _util__armorer__layers head
@pushlist _util__armorer__layers neck
@pushlist _util__armorer__layers arms
@pushlist _util__armorer__layers gloves
## chest
@pushlist _util__armorer__layers innertorso
@pushlist _util__armorer__layers pants
@pushlist _util__armorer__layers righthand
@pushlist _util__armorer__layers lefthand
@pushlist _util__armorer__layers quiver
@pushlist _util__armorer__layers outerbody


foreach _a_layer in _util__armorer__layers 
    @drop backpack
    @setvar _util__hotkey_armorer__equip_this__dclick_or_liftdrop 1

    
    
    
    ## satchels
    if findlayer self _a_layer as _this
        if  _this  !=  _util__hotkey_armorer__equipped__satchel
            @setvar  _util__hotkey_armorer__equipped__satchel  _this
        endif
    elseif _util__hotkey_armorer__mode__forget_unequipped_accessible_items == 0
        if find _util__hotkey_armorer__equipped__satchel backpack -1 -1 -1 or find _util__hotkey_armorer__equipped__satchel ground -1 -1 -1
        else
            @unsetvar _util__hotkey_armorer__equipped__satchel
        endif
    else
        @unsetvar _util__hotkey_armorer__equipped__satchel
    endif
    
    
    continue
    
    if _a_layer == head and varexist _util__hotkey_armorer__equipped__head
        @setvar  _util__hotkey_armorer__equipped__this  _util__hotkey_armorer__equipped__head
    elseif _a_layer == neck and varexist _util__hotkey_armorer__equipped__neck
        @setvar  _util__hotkey_armorer__equipped__this  _util__hotkey_armorer__equipped__neck
    elseif _a_layer == arms and varexist _util__hotkey_armorer__equipped__arms
        @setvar  _util__hotkey_armorer__equipped__this  _util__hotkey_armorer__equipped__arms
    elseif _a_layer == gloves and varexist _util__hotkey_armorer__equipped__gloves
        @setvar  _util__hotkey_armorer__equipped__this  _util__hotkey_armorer__equipped__gloves
    elseif _a_layer == innertorso and varexist _util__hotkey_armorer__equipped__chest
        @setvar  _util__hotkey_armorer__equipped__this  _util__hotkey_armorer__equipped__chest
    elseif _a_layer == pants and varexist _util__hotkey_armorer__equipped__pants
        @setvar  _util__hotkey_armorer__equipped__this  _util__hotkey_armorer__equipped__pants
    elseif _a_layer == righthand and varexist _util__hotkey_armorer__equipped__righthand
        @setvar  _util__hotkey_armorer__equipped__this  _util__hotkey_armorer__equipped__righthand
    elseif _a_layer == lefthand and varexist _util__hotkey_armorer__equipped__lefthand
        @setvar  _util__hotkey_armorer__equipped__this  _util__hotkey_armorer__equipped__lefthand
    elseif _a_layer == quiver and varexist _util__hotkey_armorer__equipped__quiver
        @setvar  _util__hotkey_armorer__equipped__this  _util__hotkey_armorer__equipped__quiver
    elseif _a_layer == outerbody and varexist _util__hotkey_armorer__equipped__outerbody
        @setvar  _util__hotkey_armorer__equipped__this  _util__hotkey_armorer__equipped__outerbody
    else
        @unsetvar _util__hotkey_armorer__equipped__this
    endif
    
    
    if varexist _util__hotkey_armorer__equipped__this

        if findlayer self _a_layer as _this
            ## if found item in layer, and not eq to what is in memory, update memory
            if  _this  !=  _util__hotkey_armorer__equipped__this
                @setvar  _util__hotkey_armorer__equipped__this  _this
            endif
        else
            if _util__hotkey_armorer__mode__forget_unequipped_accessible_items == 1
                if find _util__hotkey_armorer__equipped__this backpack -1 -1 -1 or find _util__hotkey_armorer__equipped__this ground -1 -1 -1
                    #@getlabel _util__hotkey_armorer__equipped__this _label
                else
                    @unsetvar _util__hotkey_armorer__equipped__this
                endif
            endif
        endif


        if _a_layer == head
            @setvar  _util__hotkey_armorer__equipped__head  _util__hotkey_armorer__equipped__this
        elseif _a_layer == neck
            @setvar  _util__hotkey_armorer__equipped__neck  _util__hotkey_armorer__equipped__this
        elseif _a_layer == arms
            @setvar  _util__hotkey_armorer__equipped__arms  _util__hotkey_armorer__equipped__this
        elseif _a_layer == gloves
            @setvar  _util__hotkey_armorer__equipped__gloves  _util__hotkey_armorer__equipped__this
        elseif _a_layer == innertorso
            @setvar  _util__hotkey_armorer__equipped__chest  _util__hotkey_armorer__equipped__this
        elseif _a_layer == pants
            @setvar _util__hotkey_armorer__equipped__pants  _util__hotkey_armorer__equipped__this 
        elseif _a_layer == righthand
            @setvar  _util__hotkey_armorer__equipped__righthand  _util__hotkey_armorer__equipped__this
            @getlabel! _util__hotkey_armorer__equipped__this _label
            if "throwing knife" in _label  or  "dagger" in _label  or  "spellbook" in _label
                @setvar _util__hotkey_armorer__equipped__righthand__equip__dclick_or_liftdrop 2
            endif
        elseif _a_layer == lefthand
            @setvar  _util__hotkey_armorer__equipped__lefthand  _util__hotkey_armorer__equipped__this
            if "throwing knife" in _label  or  "dagger" in _label  or  "spellbook" in _label
                @setvar _util__hotkey_armorer__equipped__lefthand__equip__dclick_or_liftdrop 2
            endif
        elseif _a_layer == quiver
            @setvar  _util__hotkey_armorer__equipped__quiver  _util__hotkey_armorer__equipped__this
        elseif _a_layer == outerbody
            @setvar  _util__hotkey_armorer__equipped__outerbody  _util__hotkey_armorer__equipped__this
        endif
    endif

    
    
endfor

stop



## shield
