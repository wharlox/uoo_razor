


#### script to automatically run after this script
####   to enable: uncomment the pushlist line, add in the path to the next script after Play Script
@removelist _util__hotkey_armorer__script_chain
@createlist _util__hotkey_armorer__script_chain
#@pushlist _util__hotkey_armorer__script_chain "Play Script: AutoDexxer"



#### modes
##   [dynamic] slot un-equip, prev-item in backpack or corpse == keep prev-item memorized OR clear memory for slot
##   [static] slot equipped, prev-item in backpack or corpse == USE NEW ITEM
##   [todo] get-all-layers or just aspectable-layers




#### forget_unequipped_accessible_items - default 0
##   if a layer is empty but slotted item is in backpack or corpse
##     0 - do not forget about item
##     1 - forget about item
@setvar!  _util__hotkey_armorer__mode__forget_unequipped_accessible_items  0




#### enforce_run_twice - default 1
##   0 disables - script will run immediatly in full
##   1 enables  - script will need to be executed twice
@setvar _util__hotkey_armorer__enforce_run_twice 1
#### ensure no more than the givin ms has passed to allow the script to continue - set to 0 to disable
@setvar _util__hotkey_armorer__enforce_run_twice_time_threshold 4000






if _util__hotkey_armorer__enforce_run_twice == 1
    @removelist _util__hotkey_armorer__name
    @createlist _util__hotkey_armorer__name
    
    #### a friendly value of this script
    @pushlist   _util__hotkey_armorer__name  "query-armor-n-weaps"


    if not timerexists _util__hotkey_armorer__enforce_run_twice__timer
        @settimer _util__hotkey_armorer__enforce_run_twice__timer 0
    endif


    if not listexists _util__hotkey_armorer__name_previous
        @createlist _util__hotkey_armorer__name_previous
        foreach _itr in _util__hotkey_armorer__name
            @pushlist _util__hotkey_armorer__name_previous _itr
            sysmsg "click again within {{_util__hotkey_armorer__enforce_run_twice_time_threshold}} ms to save armor and weapon profile" 44
            stop
        endfor
    endif


    if _util__hotkey_armorer__enforce_run_twice_time_threshold != 0
        if timer _util__hotkey_armorer__enforce_run_twice__timer > _util__hotkey_armorer__enforce_run_twice_time_threshold and listexists _util__hotkey_armorer__name_previous
            @removelist _util__hotkey_armorer__name_previous
            @removetimer _util__hotkey_armorer__enforce_run_twice__timer 
            sysmsg "aborting: took too long to click a second time. try again" 33
            stop
        endif
    endif


    foreach _itr in _util__hotkey_armorer__name
        foreach _itr_prev in _util__hotkey_armorer__name_previous
            @removelist _util__hotkey_armorer__name_previous
            if _itr == _itr_prev
                sysmsg  "saving armor and weapons..." 70
                overhead "saving armor and weapons..." 70
                @removelist _util__hotkey_armorer__name
                @removetimer _util__hotkey_armorer__enforce_run_twice__timer 
            else
                sysmsg   "ERROR: this script `{{_itr}}` does not match the previous triggered script `{{_itr_prev}}` - try again" 33
                overhead "ERROR: this script `{{_itr}}` does not match the previous triggered script `{{_itr_prev}}` - try again" 33
                stop
            endif
            break
        endfor
        break
    endfor
else
    sysmsg "saving armor and weapons..." 70
    overhead "saving armor and weapons..." 70
    if listexists _util__hotkey_armorer__name
        @removelist _util__hotkey_armorer__name
    endif
    if listexists _util__hotkey_armorer__name_previous
        @removelist _util__hotkey_armorer__name_previous
    endif
    if timerexists _util__hotkey_armorer__enforce_run_twice__timer 
        @removetimer _util__hotkey_armorer__enforce_run_twice__timer 
    endif
endif







