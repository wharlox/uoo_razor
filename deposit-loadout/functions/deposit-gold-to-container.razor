    #    endwhile
    lift  _this  15000
    drop  _deposit_gold__container__serial  -1 -1 -1
    wait 400
    @getlabel! backpack _bp
    while queued
    endwhile
endif
@clearignore 
sysmsg "deposit gold to container - complete"



