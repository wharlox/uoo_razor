@setvar! _deposit_gold__container__serial  0x50A2E401

@clearignore
while findtype "gold coin" backpack as _this
    lift  _this 60000
    drop  backpack -1 -1 -1
    wait 400
    @getlabel! backpack _bp
    @ignore _this
endwhile


