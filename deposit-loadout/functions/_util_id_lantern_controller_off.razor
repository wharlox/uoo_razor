#sysmsg "_util_id_lantern_controller_off - start"
#@setvar! _this_script "Play Script: deposit-loadout\functions\_util_id_lantern_controller_off"

if timer _util_id_lantern__time_since_last_id >= 3000
    overhead "id-lantern - timer greater than 3s - done iding  {{_util_id_lantern__time_since_last_id}}"
    if @findtype! 2594 ground 2338 any 4 as _tmp
        #sysmsg "lantern ON"
        ## if cav lantern is ON then  ... id-items of recycler
        ## 2594 is ID of light-on cav-lantern 2338 is hue
        ## 2597 is ID of light-off cav-lantern 2338 is hue
        if _tmp == _id_loop_recycler_lantern 
            #sysmsg "ID items queued" 110
            #hotkey  "Play Script: deposit-loadout\functions\_util_id_minimal" 
            # dclicktype '2594' ground 2338 any 4
            # wait 2000

            @poplist!  _script_chain  "Play Script: deposit-loadout\functions\_util_id_lantern_controller_off"
            @poplist!  _script_chain  "Play Script: deposit-loadout\functions\_util_id_minimal" 


            ## if about to turn off the lantern, and this-user is supposed to recycle
            ##   then recycle and deposit stuff
            if _tmp == _id_loop_recycler_lantern 
                #@setvar!  _whoami  name
                #if _whoami == _deposit_loadout__user_to_recycle
                if _deposit_loadout__recycle_with_current_user == 1
                    #overhead "deposit item recycler inner 1"
                    ## recycle items
                    dclick _deposit_loadout__recycler
                    waitforgump 4045111101
                    gumpresponse 6 4045111101
                    waitforgump 4045111101
                    gumpresponse 6 4045111101
                    @getlabel! backpack _bp
                    gumpclose 4045111101
                    @getlabel! backpack _bp
                    ## magic item vault
                    menu _deposit_loadout__magic_item_vault 0
                    waitfortarget _deposit_loadout__magic_item_vault
                    target _deposit_loadout__recycler
                    @getlabel! backpack _bp
                endif
            endif

            
            dclick _tmp
            @getlabel! _tmp _tmp_label
            @settimer  _util_id_lantern__time_since_last_id 0
        else
            sysmsg "ERROR set variable _id_loop_recycler_lantern to your cav lantern" 33
        #wait 1000
            
        endif
        
    endif
endif







while queued
endwhile


#sysmsg "_util_id_minimal - complete"



#### continue script chain
hotkey "Play Script: deposit-loadout\functions\_util_continue_script_chain"
