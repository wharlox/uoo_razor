dclick 0x56E3DC06
waitforgump 1859005118
## click rsrc-settings
gumpresponse 12 1859005118
waitforgump 1859005118
## settings gump
waitforgump 1116531395
## click tools button
gumpresponse 3 1116531395
waitforgump 1116531395
## sysmsg - "This character will now grab tools when restocking a resource stockpile"
## sysmsg - "This character will no longer grab tools when restocking a resource stockpile"
gumpclose 1116531395
gumpclose 1859005118
