#### get bard-items out of magic-item-recycler
#if not listexists _util__hotkey_get_instruments__list
if skill "Peacemaking" > 0 or skill "Provocation" > 0 or skill "Discordance" > 0 or skill "Musicianship" > 0
    if not listexists _util__hotkey_get_instruments__list
        if listexists _util__detect_instrument__idd_instruments
            foreach _itr in _util__detect_instrument__idd_instruments 
                # find serial src hue qty range
                if not gumpexists 4045111101
                    dclick _deposit_loadout__recycler
                    waitforgump 4045111101
                    #gumpclose 4045111101
                    @getlabel! backpack _bp
                endif
                @clearignore
                if find _itr _deposit_loadout__recycler -1 -1 1
                    lift _itr 1
                    drop backpack -1 -1 -1
                    wait 150
                    while insysmsg "You must wait to perform another action"
                        lift _itr 1
                        drop backpack -1 -1 -1
                        wait 150
                    endwhile
                    wait 510
                endif
                #@getlabel! backpack _bp
            endfor
        endif
    else
        foreach _itr in _util__hotkey_get_instruments__list 
            # find serial src hue qty range
            if not gumpexists 4045111101
                dclick _deposit_loadout__recycler
                waitforgump 4045111101
                #gumpclose 4045111101
                @getlabel! backpack _bp
            endif
            @clearignore
            if find _itr _deposit_loadout__recycler -1 -1 1
                lift _itr 1
                drop backpack -1 -1 -1
                wait 150
                while insysmsg "You must wait to perform another action"
                    lift _itr 1
                    drop backpack -1 -1 -1
                    wait 150
                endwhile
                wait 510
            endif
            #@getlabel! backpack _bp
        endfor
    endif
    if gumpexists 4045111101
        gumpclose 4045111101
    endif
endif





