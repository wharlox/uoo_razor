                wft 500
                target _util__buy_shit_n_organize__set_pack_animal
            endif
            wait 100


            menu _util__buy_shit_n_organize__resupply_shelf_serial 1
            wait 200

            if find _util__buy_shit_n_organize__set_pack_animal ground -1 -1 4
                wait 100
                menu _util__buy_shit_n_organize__resupply_shelf_serial 0
                wft 500
                target _util__buy_shit_n_organize__set_pack_animal
            endif



            
            foreach _itr in _util__buy_shit_n_organize__mages_rune_tome_chest_path
                dclick _itr
                wait 400
            endfor
            say "All Follow Me"

            overhead "recall to NPCs"
            #whisper "[recall"
            cast "Recall"
            overhead "***" 44 _util__buy_shit_n_organize__mages_rune_tome_serial
            overhead "***" 44 _util__buy_shit_n_organize__mages_rune_tome_serial
            waitforsysmsg "Select Marked item" 2500
            target _util__buy_shit_n_organize__mages_rune_tome_serial

            sysmsg "222  {{_util__buy_shit_n_organize__mages_rune_tome_serial}}"
            wait 500

        endwhile
        sysmsg "333"
    endif

    @setvar _color_alternate 0
