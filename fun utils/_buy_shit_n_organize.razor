## satchels
@clearignore
@setvar! _util__buy_shit_n_organize__has_wiz_satchel_on_body 0
if findlayer self outerbody as _this
    @getlabel! _this _label
    if "wizard" in _label
        @setvar! _util__buy_shit_n_organize__has_wiz_satchel_on_body 1
    elseif "potion" in _label
        lift _this
        drop backpack -1 -1 -1
        wait 510
     endif
endif
if _util__buy_shit_n_organize__has_wiz_satchel_on_body == 0
    ## try to equip one if in backpack
    @clearignore
    while _util__buy_shit_n_organize__has_wiz_satchel_on_body == 0 and findtype "reagent satchel" backpack -1 -1 -1 as _this
        @ignore _this
        @getlabel! _this _label
        if "(0 items, 0 stones)" in _label
        else
            lift _this
            drop self outerbody
            wait 510
            @setvar! _util__buy_shit_n_organize__has_wiz_satchel_on_body 11
        endif
    endwhile
endif


@removelist _itr
@removetimer _itr
@unsetvar _itr


while not dead
    @clearignore
    


    #### if AT HOME then deposit shit
    if position  _util__buy_shit_n_organize__home_coordinate_x  _util__buy_shit_n_organize__home_coordinate_y
        dclick _util__buy_shit_n_organize__set_pack_animal
        while  position  _util__buy_shit_n_organize__home_coordinate_x  _util__buy_shit_n_organize__home_coordinate_y
            overhead "deposit shit time"
            if not hidden
                skill Hiding
            endif


            menu _util__buy_shit_n_organize__stockpile_serial 0
            wft 500
            target self
            
            if find _util__buy_shit_n_organize__set_pack_animal ground -1 -1 4
