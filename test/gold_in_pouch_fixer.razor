                    @setvar _this_good 2
                    overhead "g" 44 _this
                    wait _util_overhead_delay
                else
                    sysmsg "not 45k {{_label2}}" 22
                    lift _this 30000
                    drop _gold_container_to_fix 1 1 1
                    @getlabel _this _label2
                    wait 430
                    if "gold coin : 30000" in _label2
                        sysmsg "if 30k {{_label2}}" 22
                        @setvar _this_good 2
                        overhead "g" 44 _this
                        wait _util_overhead_delay
                    else
                        sysmsg "not 30k {{_label2}}" 22
                        lift _this 15000
                        drop _gold_container_to_fix 1 1 1
                        @getlabel _this _label2
                        wait 430
                        if "gold coin : 15000" in _label2
                            sysmsg "if 15k {{_label2}}" 22
                            @setvar _this_good 2
                            overhead "g" 44 _this
                            wait _util_overhead_delay
                        endif
                        ## end 15k lift
                    endif
                    ## end 30k lift
                endif
                ## end 45k lift
            endif
        #    if "0000" in _label or "5000" in _label
