if 1 == 1
    ## ensure 60k gold stacks
    while findtype 'gold coin'  _gold_container_to_fix  -1 -1 -1 as _this
        if inlist _util__gold_container_60ks _this
            @ignore _this
        else
            @getlabel! _this _label
            @overhead "FIND" _this 49
            @setvar _this_good 1
            ## _this_good  1==not-good  2==good
            if "gold coin : 60000" in _label 
                sysmsg "ultra good" 22
                @setvar _this_good 2
                overhead "g" 44 _this
                wait _util_overhead_delay
                @pushlist _util__gold_container_60ks _this
            elseif "gold coin : 45000"  in _label  or "gold coin : 30000" in _label or "gold coin : 15000"  in _label 
