overhead "select container to fix"
sysmsg "select container to fix"
if varexist _gold_container_to_fix
    @unsetvar _gold_container_to_fix
endif
while not varexist _gold_container_to_fix
    @setvar _gold_container_to_fix
endwhile


overhead "select overflow container"
sysmsg   "select overflow container"
if varexist _gold_overflow_container
    @unsetvar _gold_overflow_container
endif
while not varexist _gold_overflow_container
    @setvar _gold_overflow_container
    if _gold_overflow_container == _gold_container_to_fix
        overhead "overflow container cannot be the same as container-to-fix, pick another"
        sysmsg   "overflow container cannot be the same as container-to-fix, pick another"
        @unsetvar _gold_overflow_container
    endif
endwhile

