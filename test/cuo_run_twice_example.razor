#### simple description
#### longer part of descr
#### in-game macro- whisper: >script test\cuo_run_twice_example

    

@removelist _util__hotkey_this_activate__name
@createlist _util__hotkey_this_activate__name

#### edit this value with a friendly name of this script
@pushlist   _util__hotkey_this_activate__name  "backstabber"



## enforce_run_twice
##   0 disables - clicking the script runs immediatly
##   1 enables  - script will need to be executed twice
@setvar _util__hotkey_this_activate__enforce_run_twice 1
#### ensure no more than the givin ms has passed to allow the script to continue - set to 0 to disable
@setvar _util__hotkey_this_activate__enforce_run_twice_time_threshold 2000
@setvar _util__hotkey_this_activate__enforce_run_twice_time_threshold__clear 5000




#### script to automatically run after this script runs successfully
####   to enable- uncomment the pushlist line, add in the path to the next script after Play Script
#### TOTO SAMPLE
#@removelist _util__hotkey_armorer__script_chain
#@createlist _util__hotkey_armorer__script_chain
#@pushlist _util__hotkey_armorer__script_chain "Play Script: AutoDexxer"









#### script logic below


foreach _itr in _util__hotkey_this_activate__name
    #@pushlist _util__hotkey_this_activate__name_previous _itr
    sysmsg "starting: {{_itr}}" 68
endfor


if _util__hotkey_this_activate__enforce_run_twice == 1
    if not timerexists _util__hotkey_this_activate__enforce_run_twice_timer
        @settimer _util__hotkey_this_activate__enforce_run_twice_timer 0
    elseif timer _util__hotkey_this_activate__enforce_run_twice_timer >= _util__hotkey_this_activate__enforce_run_twice_time_threshold__clear
        ## if timer been running a long time, reset it to 0
        @settimer _util__hotkey_this_activate__enforce_run_twice_timer 0
        @removelist _util__hotkey_this_activate__name_previous
    endif

    if not listexists _util__hotkey_this_activate__name_previous
        @createlist _util__hotkey_this_activate__name_previous
        foreach _itr in _util__hotkey_this_activate__name
            @pushlist _util__hotkey_this_activate__name_previous _itr
            sysmsg   "click again to confirm: {{_itr}}" 44
            overhead "click again to confirm: {{_itr}}" 44
            stop
        endfor
    endif

    if _util__hotkey_this_activate__enforce_run_twice_time_threshold != 0
        if timer _util__hotkey_this_activate__enforce_run_twice_timer > _util__hotkey_this_activate__enforce_run_twice_time_threshold and listexists _util__hotkey_this_activate__name_previous
            #@removelist _util__hotkey_this_activate__name_previous
            @removetimer _util__hotkey_this_activate__enforce_run_twice_timer 
            foreach _itr in _util__hotkey_this_activate__name
                sysmsg "took too long to click a second time. try again to confirm: {{_itr}}" 33
                @settimer _util__hotkey_this_activate__enforce_run_twice_timer 0
                stop
            endfor
        endif
    endif

    foreach _itr in _util__hotkey_this_activate__name
        foreach _itr_prev in _util__hotkey_this_activate__name_previous
            @removelist _util__hotkey_this_activate__name_previous
            if _itr == _itr_prev
                #70
                sysmsg  "activating: {{_itr}}" 99
                overhead "activating: {{_itr}}" 99
                @removelist _util__hotkey_this_activate__name
            else
                sysmsg   "ERROR: this script `{{_itr}}` does not match the previous triggered script `{{_itr_prev}}` - try again" 33
                overhead "ERROR: this script `{{_itr}}` does not match the previous triggered script `{{_itr_prev}}` - try again" 33
                stop
            endif
            break
        endfor
        break
    endfor
else
    if listexists _util__hotkey_this_activate__name
        @removelist _util__hotkey_this_activate__name
    endif
    if listexists _util__hotkey_this_activate__name_previous
        @removelist _util__hotkey_this_activate__name_previous
    endif
endif
if timerexists _util__hotkey_this_activate__enforce_run_twice_timer 
    @removetimer _util__hotkey_this_activate__enforce_run_twice_timer 
endif




