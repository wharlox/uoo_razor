    hotkey "Cancel Current Target"
endif
if findtype 3901 >= 1 backpack 
    overhead 'Using Essence'
    dclicktype 3901
    waitfortarget
    target 'self'
endif 

hotkey 'play script: Subs\Routing' 
   
stop
